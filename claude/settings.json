{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "model": "fable[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ echo '[Session start, before replying: pick a role; arm IAC_NAME=<role> iac monitor (Monitor tool); in a git repo run dv monitor --once --as <role> as a background Bash task. iac, last 20:]'; ~/.local/bin/iac read -n 20; } 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Reading iac"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/bin/scripts/claude-session-sync session-start 2>>~/.cache/claude-session-sync.log || true",
            "timeout": 20,
            "statusMessage": "Pulling sessions from peers"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/bin/scripts/claude-session-sync turn-end 2>>~/.cache/claude-session-sync.log || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ct pane-state --claude-hook 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/bin/scripts/claude-session-sync session-end 2>>~/.cache/claude-session-sync.log || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ct pane-state --claude-hook 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "ct pane-state --claude-hook 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
