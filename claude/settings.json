{
  "model": "fable[1m]",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ echo '[iac team channel, last 20 — arm IAC_NAME=<role> iac monitor now]'; ~/.local/bin/iac read -n 20; } 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Reading iac"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/bin/scripts/claude-session-sync session-start 2>>~/.cache/claude-session-sync.log || true",
            "timeout": 20,
            "statusMessage": "Pulling sessions from peers"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/bin/scripts/claude-session-sync turn-end 2>>~/.cache/claude-session-sync.log || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/bin/scripts/claude-session-sync session-end 2>>~/.cache/claude-session-sync.log || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
