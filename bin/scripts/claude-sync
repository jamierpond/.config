#!/usr/bin/env bash
# Make ~/.config/claude the Claude Code config dir, and link each repo's
# auto-memory directory into claude/memory.
set -euo pipefail

# git-bash's ln -s copies unless told to make real Windows symlinks.
case "$(uname -s)" in MINGW*|MSYS*) export MSYS=winsymlinks:nativestrict ;; esac

cfg="$(cd "$(dirname "$0")/../.." && pwd)"
claude_dir="$cfg/claude"
mem_root="$cfg/claude/memory"
mkdir -p "$claude_dir" "$mem_root"

"$cfg/bin/scripts/claude-config-dir-migrate"

# Claude Code names a project's dir after its native path (C:\Users\... on Windows).
native_path() { if command -v cygpath >/dev/null; then cygpath -w "$1"; else printf '%s' "$1"; fi; }
slug() { native_path "$1" | sed 's/[^A-Za-z0-9]/-/g'; }
name() { local rel="${1#"$HOME"/}"; printf '%s' "${rel//\//-}"; }

link_memory() {
    local repo="$1"
    [ -d "$repo" ] || return 0
    local src="$claude_dir/projects/$(slug "$repo")/memory"
    local dst="$mem_root/$(name "$repo")"
    if [ -d "$src" ] && [ ! -L "$src" ] && [ -n "$(ls -A "$src")" ]; then
        mkdir -p "$dst"
        mv -n "$src"/* "$dst"/
        rmdir "$src" 2>/dev/null || { echo "!! $src still has files, not linked"; return 0; }
        echo "migrated $(name "$repo")"
    fi
    [ -d "$dst" ] || return 0
    [ -L "$src" ] && [ "$(readlink "$src")" = "$dst" ] && return 0
    [ -d "$src" ] && rmdir "$src"
    mkdir -p "$(dirname "$src")"
    ln -sfn "$dst" "$src"
    echo "linked  $(name "$repo")"
}

for repo in "$cfg" "$HOME/projects" "$HOME"/projects/* "$HOME/eacp" "$HOME"/Code/*; do
    link_memory "$repo"
done
