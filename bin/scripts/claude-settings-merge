#!/usr/bin/env bash
# Merge the repo's shared Claude Code settings into ~/.claude/settings.json.
# Repo keys win; keys only in the local file stay. Writes only when something changes.
set -euo pipefail

cfg="$(cd "$(dirname "$0")/../.." && pwd)"
settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
command -v jq >/dev/null || { echo "claude-settings-merge: jq not installed" >&2; exit 0; }
mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' > "$settings"

merged="$(jq -s '.[0] * .[1]' "$settings" "$cfg/claude/settings.json")"
[ "$merged" = "$(jq . "$settings")" ] && exit 0
printf '%s\n' "$merged" > "$settings.tmp"
mv "$settings.tmp" "$settings"
echo "claude-settings-merge: updated $settings" >&2
