#!/usr/bin/env bash
# Rebuilds eyalamirmusic/eacp@jp/develop: eyal/develop plus one commit per
# listed fix branch (its pull request's net change), linear, no merge commits.
# Pushes the branch with --force-with-lease and a tag jp/develop/<date>.<n> for
# the new head, so commits that pond apps pinned stay fetchable after the next
# rebuild orphans them, then starts eacp CI on it.
#
# Usage: eacp-jp-develop [--no-push]
#   EACP_REPO     the eacp checkout to work from [~/projects/eacp]
#   EACP_WORKTREE the worktree jp/develop is built in [~/projects/eacp-jp-develop]
set -euo pipefail

# One fix branch per line, applied in this order, all on eyal (eyalamirmusic/eacp).
# <branch>:<base> marks a branch whose pull request is stacked on another listed one.
fixBranches=(
    eyal/jp/gpuview-hidden-releases-drawables # 268
    eyal/jp/gpu-adapter-log # 269
    eyal/jp/rpc-reply-session-id # 295
    eyal/jp/ci-sanitizer-nightly # 272
    eyal/jp/full-lto-parent-scope # 206
    eyal/jp/zip-skip-empty-copy # 194
    eyal/jp/overlay-depth-attachment # 270, was #164 on jamierpond/eacp
    eyal/jp/globalhotkey-is-available # 143
    eyal/jp/webview-browser-options # 146
    eyal/jp/webview-focused # 152
    eyal/jp/vulkan-1-1-fallbacks # 109
    eyal/jp/render-scale-on-develop:eyal/jp/vulkan-1-1-fallbacks # 281, stacked on 109
    eyal/jp/text-editor-line-keys-undo # 275
    eyal/jp/webview-content-process-terminate # 276, was #46
    eyal/jp/global-mouse-click-monitor # 280
    eyal/jp/machine-usage # 277
    eyal/jp/async-keeps-exception # 278
    eyal/jp/process-child-environment # 279
    eyal/jp/ios-status-bar # 291
    eyal/jp/http-server-bind-address # 293
    eyal/jp/ios-notifications # 294
    eyal/jp/websocket-refused-connection-crash # 296
)

shouldPush=1
if [[ "${1:-}" == "--no-push" ]]; then
    shouldPush=0
fi

repo="${EACP_REPO:-$HOME/projects/eacp}"
worktree="${EACP_WORKTREE:-$HOME/projects/eacp-jp-develop}"

git -C "$repo" fetch --quiet eyal --tags
git -C "$repo" fetch --quiet origin

if [[ ! -d "$worktree" ]]; then
    git -C "$repo" worktree add --detach "$worktree" eyal/develop
fi
cd "$worktree"
if [[ -n "$(git status --porcelain)" ]]; then
    echo "eacp-jp-develop: $worktree has uncommitted changes; stopping" >&2
    exit 1
fi
git checkout --quiet -B jp/develop eyal/develop

for entry in "${fixBranches[@]}"; do
    # An entry is <branch>, or <branch>:<base> for a branch stacked on another
    # listed branch; a stacked branch contributes only its change over its base.
    branch="${entry%%:*}"
    stackedOn=""
    if [[ "$entry" == *:* ]]; then
        stackedOn="${entry#*:}"
    fi
    # A fix branch may carry develop merges; take only its net change, as one
    # commit, so jp/develop stays linear and each commit cherry-picks onto develop.
    changeBase="eyal/develop..."
    if [[ -n "$stackedOn" ]]; then
        changeBase="$stackedOn "
    fi
    if git diff --quiet $changeBase"$branch"; then
        echo "eacp-jp-develop: $branch has nothing its base lacks; drop it from the list"
        continue
    fi
    headBranch="${branch#*/}"
    # An open pull request wins over a closed one that used the same branch name.
    pullRequest=$(gh pr list --repo eyalamirmusic/eacp --head "$headBranch" --state all \
        --json number,title,state --jq 'sort_by(.state != "OPEN") | .[0] | "\(.number)\t\(.title)"')
    pullRequestNumber="${pullRequest%%$'\t'*}"
    pullRequestTitle="${pullRequest#*$'\t'}"
    echo "eacp-jp-develop: #$pullRequestNumber $entry"
    if [[ -n "$stackedOn" ]]; then
        if ! git diff --binary "$stackedOn" "$branch" | git apply --3way --index --quiet 2>/dev/null; then
            echo "eacp-jp-develop: $branch's change over $stackedOn conflicts with the branches before it." >&2
            git reset --quiet --hard
            exit 1
        fi
    elif ! git merge --squash --quiet "$branch" >/dev/null 2>&1; then
        echo "eacp-jp-develop: $branch conflicts with develop or a branch before it." >&2
        echo "Rebase $branch onto develop (or move it later in the list), then rerun." >&2
        git merge --abort 2>/dev/null || git reset --quiet --hard
        exit 1
    fi
    git commit --quiet -m "$pullRequestTitle" \
        -m "From eyalamirmusic/eacp#$pullRequestNumber, branch $headBranch."
done

if [[ "$shouldPush" == 0 ]]; then
    echo "eacp-jp-develop: built $(git rev-parse --short HEAD); not pushed (--no-push)"
    exit 0
fi

today=$(date +%Y-%m-%d)
tagNumber=1
while git rev-parse --quiet --verify "refs/tags/jp/develop/$today.$tagNumber" >/dev/null; do
    tagNumber=$((tagNumber + 1))
done
tag="jp/develop/$today.$tagNumber"

git tag "$tag" HEAD
git push --force-with-lease=jp/develop eyal jp/develop
git push eyal "refs/tags/$tag"
# eacp's Build workflow runs on push only for main and develop.
gh workflow run build.yml --repo eyalamirmusic/eacp --ref jp/develop
echo "eacp-jp-develop: pushed jp/develop at $(git rev-parse HEAD), tagged $tag"
