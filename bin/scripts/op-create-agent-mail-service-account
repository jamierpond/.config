#!/usr/bin/env bash
# Creates a 1Password service account on the personal account that can read
# one vault holding a Gmail app password, so agents can send Jamie email.
# Run it yourself: the 1Password desktop app asks for approval.
#
# Service accounts can't be given the built-in Personal vault, so the Gmail
# login lives in its own vault.
#
# Agents then read it with:
#   OP_SERVICE_ACCOUNT_TOKEN=$OP_AGENT_MAIL_SERVICE_ACCOUNT_TOKEN \
#     op read "op://Agents/Gmail/password"
set -euo pipefail

account="my.1password.com"
vault="Agents"
item="Gmail"
service_account="agent-mail"
token_variable="OP_AGENT_MAIL_SERVICE_ACCOUNT_TOKEN"
secrets_file="$HOME/.secrets"

# The shell's own service account token would otherwise take over from the desktop app sign-in.
unset OP_SERVICE_ACCOUNT_TOKEN

run_op() {
  op --account "$account" "$@"
}

if grep -q "^export $token_variable=" "$secrets_file" 2>/dev/null; then
  echo "$token_variable is already in $secrets_file; not creating a second service account." >&2
  exit 1
fi

if ! run_op vault get "$vault" >/dev/null 2>&1; then
  run_op vault create "$vault" --description "Secrets agents may read" >/dev/null
  echo "Created vault $vault."
fi

if ! run_op item get "$item" --vault "$vault" >/dev/null 2>&1; then
  echo "Gmail app password: make one at https://myaccount.google.com/apppasswords"
  read -r -p "Gmail address: " gmail_address
  read -r -s -p "App password: " gmail_app_password
  echo
  jq -n --arg title "$item" --arg address "$gmail_address" --arg password "$gmail_app_password" '{
    title: $title,
    category: "LOGIN",
    fields: [
      {id: "username", type: "STRING", purpose: "USERNAME", label: "username", value: $address},
      {id: "password", type: "CONCEALED", purpose: "PASSWORD", label: "password", value: $password}
    ]
  }' | run_op item create --vault "$vault" - >/dev/null
  echo "Created item $item in $vault."
fi

token="$(run_op service-account create "$service_account" --vault "$vault:read_items" --raw)"

touch "$secrets_file"
chmod 600 "$secrets_file"
printf 'export %s=%s\n' "$token_variable" "$token" >>"$secrets_file"
echo "Service account $service_account created; token saved to $secrets_file as $token_variable."
echo "It is shown only once: copy that line to the other machines' ~/.secrets."
