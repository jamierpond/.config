# Allowlist pattern: ignore everything, then selectively include.
# Add new config files/dirs with ! prefix to track them.
/*

# Git
!.gitignore
!.github

!rudder.json

# Agent/editor instructions
!AGENTS.md
!CLAUDE.md
!claude/
!README.md

# Shell config
!ssh/
!shellrc
!bashrc
!zshrc
!prompt.zsh
!vi-mode.zsh
!completion.zsh

# App configs
!btop/
!nvim/
!tmux/
!bin/
!iterm2/
!karabiner/
karabiner/automatic_backups/
!lazygit/
!aerospace
!windows/
!r2-backup
!colima/
colima/**
!colima/default/
!colima/default/colima.yaml
!direnv/
!git/
git/*
!git/hooks/
!screenrc

# Nix config
!flake.nix
!flake.lock
!home/
!darwin/
!nix/
!Dockerfile
!setup.sh
!mac-bootstrap.sh

# Script data
!bin/scripts/quick-urls.yaml
bin/scripts/quick-url-github-repos.txt

# Media (only bell notification sound)
!bell.mp3

# Misc tracked files

# Always ignore
**Application Support**
**.DS_Store**
.crush
*.conf

# Override *.conf for nix config (must come after *.conf)
!nix/nix.conf
!btop/btop.conf
!windows/psmux.conf
!justfile
